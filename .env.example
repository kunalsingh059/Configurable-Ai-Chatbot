GROQ_API_KEY = your_groq_api_key_here
LLM_PROVIDER = groq
MONGO_URI = mongodb+srv://user:password@cluster.mongodb.net/dbname

# Redis - used for chat sessions and rate limiting (see app/redis_client.py).
# Local dev: run `redis-server` and use redis://localhost:6379.
# Render/production: use your Upstash (or other) connection string - it
# will start with rediss:// (note the double s - TLS is required).
REDIS_URL=redis://localhost:6379

JWT_SECRET = your_random_jwt_secret_here
SUPERADMIN_USERNAME = admin
SUPERADMIN_PASSWORD = change_me

# Required for the "forgot password" email feature - see app/email_service.py
GMAIL_ADDRESS = your_email@gmail.com
GMAIL_APP_PASSWORD = your_gmail_app_password

# Where admin-vue's reset-password page lives (match its actual dev/prod URL)
FRONTEND_RESET_URL=http://localhost:5174/reset-password

# Comma-separated frontend origins allowed to call the API. Not required for
# local dev (falls back to localhost:5173 + 5174 automatically) - only set
# this once you deploy admin-vue/widget-vue to a real domain.
# CORS_ALLOWED_ORIGINS=https://admin.yourdomain.com

# Max document upload size in MB. Optional - defaults to 10.
MAX_UPLOAD_SIZE_MB=10

# Rate limits (per minute). Optional - these are already the defaults if
# you omit them, listed here so you know they exist and can tune them.
CHAT_SESSION_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_MINUTE=12

# Shared cap across ALL businesses combined - protects Groq's org-wide 30
# RPM ceiling, which the two per-tenant limits above can't see past on
# their own (each is scoped to one business/session). See app/main.py's
# comment on GLOBAL_CHAT_RATE_LIMIT_PER_MINUTE for the math behind 12.
GLOBAL_CHAT_RATE_LIMIT_PER_MINUTE=12
FORGOT_PASSWORD_RATE_LIMIT_PER_MINUTE=5


MAX_MESSAGE_LENGTH=1000
MAX_CONVERSATION_HISTORY=20
SESSION_IDLE_TIMEOUT_MINUTES=60
REGISTER_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Wall-clock ceiling (seconds) on an ENTIRE /chat turn - covers the LLM
# call(s) AND every tool-call hop. Default: 45.
MAX_CHAT_TURN_SECONDS=45


# Max tool-call hops the model can make in a single /chat turn. IMPORTANT:
# worst-case Groq request volume is roughly CHAT_RATE_LIMIT_PER_MINUTE x
# MAX_TOOL_HOPS, not just CHAT_RATE_LIMIT_PER_MINUTE - check this against
# your actual Groq plan's real rate limit at console.groq.com and lower
# either value if needed. Default: 5.
MAX_TOOL_HOPS=5

TOOL_HEADERS_ENCRYPTION_KEY=tool_headers_encryption_key_here


# Embed security (see app/auth.py and app/rate_limit.py)
# ---------------------------------------------------------------------------
# Max requests per minute from ONE real client IP to /chat + /widget/config.
PUBLIC_IP_RATE_LIMIT_PER_MINUTE=60

# How many reverse proxies sit in front of the app, so the real visitor IP can
# be read from X-Forwarded-For. 0 = no proxy (local dev). On Render start by
# testing 1, and VERIFY it (set LOG_LEVEL=DEBUG, call the API from two
# different networks, check the logged client_ip differs) - too low
# over-limits real users, too high lets a visitor spoof their IP.
TRUSTED_PROXY_HOPS=0

# false: businesses with no allowed websites listed are unrestricted (so
# existing accounts keep working). true: they are refused until they list at
# least one website. Set true in production once every business has one.
REQUIRE_ALLOWED_DOMAINS=false